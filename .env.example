NODE_ENV=development
PORT=5100
LOG_LEVEL=debug
LOG_PRETTY=true
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Base URL of the SLR backend (slr-be) that provides validated review output.
SLR_API_BASE_URL=http://localhost:5000

# Development-only auth (ignored when NODE_ENV=production). Without it, or a configured token verifier, every request gets 401.
# Send `X-Dev-User-Id: <uid>` to act as another user.
DEV_AUTH_ENABLED=true
DEV_AUTH_UID=dev_user
DEV_AUTH_EMAIL=dev@slr-writing.local

# Max JSON body size. A slr-be corpus with many studies can be large.
JSON_BODY_LIMIT=50mb

# PostgreSQL. Matches docker-compose.yml (host port 5433 avoids clashing with a local Postgres on 5432).
DATABASE_URL=postgresql://slr_writing:slr_writing@localhost:5433/slr_writing?schema=public

# Firebase project that issues the ID tokens, shared with slr-be. REQUIRED when NODE_ENV=production (the server refuses to start without it).
# Leave empty in development to use dev auth only.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development with the Firebase Auth emulator (started by slr-be's `npm run emulators`, port 9099): set the emulator project id above
# (slr-system-dev), turn DEV_AUTH_ENABLED off, and uncomment the next line. Refused unless NODE_ENV is development or test.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Also reject revoked tokens. Needs service-account credentials in the environment (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_CHECK_REVOKED=false

# Creating a project asks slr-be whether the caller can read the SLR project being linked. Keep true except for offline work.
SLR_VERIFY_PROJECT_ACCESS=true

# Importing a run posted by the client (POST /snapshots). Defaults to true outside production and false in production.
# ALLOW_MANUAL_SNAPSHOT_IMPORT=false

# Max POST /snapshots/from-slr calls per user per minute (each call makes several requests to slr-be).
FROM_SLR_RATE_LIMIT_PER_MINUTE=20

# H1 (and later H2, H3) are decided by the OWNER of the SLR project on slr-be: the caller's role is asked of slr-be at the moment of the decision.
# Turn off only for local work without slr-be; with it off, anyone who owns the writing project can approve.
REQUIRE_SLR_OWNER_FOR_APPROVAL=true

# LLM (Gemini). The key is a secret: keep it only in your own .env, never commit it, never paste it into chat or tickets.
# Without a provider and a key, steps that need a model answer 503 LLM_NOT_CONFIGURED.
# GEMINI_API_KEY=
# LLM_PROVIDER=gemini            # gemini | none. Unset: gemini when there is a key, otherwise none.
GEMINI_MODEL=gemini-3.5-flash
# Thinking tokens count against the output limit. 0 = off (the default; not every model allows it).
# GEMINI_THINKING_BUDGET=0
LLM_TIMEOUT_MS=60000          # one request to the service
LLM_TOTAL_TIMEOUT_MS=120000    # the whole call, retries and waits included
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_INPUT_CHARS=200000
LLM_MAX_CONCURRENCY=4
# Rate limiting and request pacing for Gemini or custom LLM quotas.
# LLM_RATE_LIMIT_RPM: Max requests per minute. Recommended: 5 for Gemini Free Tier (gemini-3.5-flash / 3.6-flash). 0 = unlimited.
LLM_RATE_LIMIT_RPM=0
# LLM_MIN_REQUEST_INTERVAL_MS: Explicit minimum ms between request dispatches (e.g. 12000 for 5 RPM). 0 = disabled.
LLM_MIN_REQUEST_INTERVAL_MS=0
# Most tokens (input + output) per UTC day for this server process, counted in memory. 0 = no limit.
LLM_DAILY_TOKEN_BUDGET=0

// Schema Phase 1: snapshot bất biến của một run SLR (xem docs/adr/ADR-005-source-of-truth.md).
// Prisma 7: URL kết nối nằm trong prisma.config.ts, không nằm ở đây.
//
// Quy ước:
// - `externalId` là ID gốc của slr-be (study_id, finding_id, evidence_id, claim_id, rq_id). Duy nhất trong một snapshot.
// - Dữ liệu con của ReviewSnapshot chỉ được ghi lúc import, sau đó không sửa. Tầng service giữ quy tắc này.
// - ExtractedFinding là "finding" của slr-be (giá trị trích xuất). Kết luận tổng hợp là Claim (theme).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SnapshotStatus {
  IMPORTED
  READY
  BLOCKED
  STALE
}

enum ArtifactType {
  A1
  A2
  A3
  A4
  A5
  A6
  A7
  A8
  A9
  A10
}

enum ArtifactReviewStatus {
  unreviewed
  needs_human_review
  approved
  rejected
}

enum ArtifactValidationStatus {
  valid
  invalid
  not_applicable
}

enum ThemeLinkStatus {
  resolved
  resolved_not_reported
  unresolved
}

enum ValueDrift {
  unchanged
  changed
  unknown
}

enum ConsensusMatch {
  match
  mismatch
  unknown
}

/// Không gian làm việc của người dùng trong hệ thống Writing, gắn với một project SLR ở slr-be.
model Project {
  id           String            @id @default(uuid())
  name         String
  /// uid Firebase của chủ sở hữu
  ownerId      String
  /// ID project trong slr-be
  slrProjectId String
  createdAt    DateTime          @default(now())
  snapshots    ReviewSnapshot[]
  provenance   ProvenanceEvent[]
  manuscripts  Manuscript[]

  @@unique([ownerId, slrProjectId])
}

/// Bản sao bất biến của một run SLR. Import lại cùng run và cùng corpusHash thì không tạo bản mới.
model ReviewSnapshot {
  id               String         @id @default(uuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceSystem     String         @default("slr-be")
  sourceRunId      String
  corpusHash       String
  corpusVersion    String
  generatorVersion String
  /// Phiên bản schema của snapshot trong hệ thống này
  schemaVersion    String         @default("1.0")
  status           SnapshotStatus @default(IMPORTED)
  /// SHA-256 của nội dung đã import, dùng kiểm tra toàn vẹn
  integrityHash    String
  importedBy       String
  importedAt       DateTime       @default(now())
  /// Các vấn đề của corpus (corpus.issues) và kết quả readiness
  issues           Json?

  researchQuestions ResearchQuestion[]
  studies           Study[]
  documents         SourceDocument[]
  findings          ExtractedFinding[]
  evidence          Evidence[]
  claims            Claim[]
  artifacts         SnapshotArtifact[]
  supplements       SnapshotSupplement[]
  manuscripts       Manuscript[]
  provenance        ProvenanceEvent[]

  // Same run and corpus but different content (for example a changed PRISMA export), or a different source (fetched vs posted by hand), is a different snapshot.
  @@unique([projectId, sourceSystem, sourceRunId, corpusHash, integrityHash])
  @@index([projectId])
}

model ResearchQuestion {
  id         String         @id @default(uuid())
  snapshotId String
  snapshot   ReviewSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  externalId String
  code       String?
  text       String
  claims     Claim[]

  @@unique([snapshotId, externalId])
}

model Study {
  id               String             @id @default(uuid())
  snapshotId       String
  snapshot         ReviewSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  externalId       String
  title            String
  authors          String[]
  year             Int?
  /// Giữ null nếu corpus không có. Không tự bổ sung DOI.
  doi              String?
  venue            String?
  keywords         String[]
  extractionStatus String
  documents        SourceDocument[]
  findings         ExtractedFinding[]
  evidence         Evidence[]
  claimItems       ClaimItem[]

  @@unique([snapshotId, externalId])
  @@index([snapshotId])
}

model SourceDocument {
  id              String         @id @default(uuid())
  snapshotId      String
  snapshot        ReviewSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  studyId         String
  study           Study          @relation(fields: [studyId], references: [id], onDelete: Restrict)
  externalId      String
  kind            String
  sourceRevisions String[]
  sourceHashes    String[]
  evidence        Evidence[]

  @@unique([snapshotId, externalId])
}

/// Giá trị trích xuất theo consensus của reviewer (không phải trích dẫn nguyên văn).
model ExtractedFinding {
  id            String            @id @default(uuid())
  snapshotId    String
  snapshot      ReviewSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  studyId       String
  study         Study             @relation(fields: [studyId], references: [id], onDelete: Restrict)
  externalId    String
  fieldId       String
  fieldName     String
  sectionName   String
  role          String?
  valueText     String
  isNotReported Boolean           @default(false)
  evidence      EvidenceFinding[]
  claimItems    ClaimItem[]

  @@unique([snapshotId, externalId])
  @@index([studyId])
}

/// Trích dẫn nguyên văn kèm vị trí nguồn (source anchor). Vị trí theo đoạn Markdown, không phải trang PDF.
model Evidence {
  id                String            @id @default(uuid())
  snapshotId        String
  snapshot          ReviewSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  studyId           String
  study             Study             @relation(fields: [studyId], references: [id], onDelete: Restrict)
  documentId        String
  document          SourceDocument    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  externalId        String
  fieldId           String
  sourceRevision    String
  sourceHash        String?
  quote             String
  quoteHash         String?
  quoteHashVerified Boolean           @default(false)
  page              Int?
  section           String?
  /// Chỉ số đoạn 0-based trong Markdown của GROBID
  paragraph         Int?
  tableOrFigure     String?
  charStart         Int?
  charEnd           Int?
  consensusMatch    ConsensusMatch    @default(unknown)
  findings          EvidenceFinding[]

  @@unique([snapshotId, externalId])
  @@index([studyId])
}

model EvidenceFinding {
  evidenceId String
  evidence   Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  findingId  String
  finding    ExtractedFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@id([evidenceId, findingId])
  @@index([findingId])
}

/// Theme do nhà nghiên cứu định nghĩa trong slr-be. Đây là nguồn của SynthesisFinding.
model Claim {
  id                 String            @id @default(uuid())
  snapshotId         String
  snapshot           ReviewSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  externalId         String
  title              String
  description        String?
  researchQuestionId String?
  researchQuestion   ResearchQuestion? @relation(fields: [researchQuestionId], references: [id], onDelete: Restrict)
  items              ClaimItem[]

  @@unique([snapshotId, externalId])
}

model ClaimItem {
  id         String            @id @default(uuid())
  claimId    String
  claim      Claim             @relation(fields: [claimId], references: [id], onDelete: Restrict)
  externalId String
  findingId  String?
  finding    ExtractedFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)
  studyId    String?
  study      Study?            @relation(fields: [studyId], references: [id], onDelete: Restrict)
  linkStatus ThemeLinkStatus
  valueDrift ValueDrift        @default(unknown)
  /// Ghi chú của researcher, không phải văn bản nguồn
  notes      String?

  @@unique([claimId, externalId])
}

/// Artifact A1..A10 của run, lưu nguyên payload để dùng làm đầu vào cho bước viết.
model SnapshotArtifact {
  id               String                   @id @default(uuid())
  snapshotId       String
  snapshot         ReviewSnapshot           @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  artifactType     ArtifactType
  artifactId       String
  schemaVersion    String
  contentHash      String
  reviewStatus     ArtifactReviewStatus
  validationStatus ArtifactValidationStatus
  payload          Json

  @@unique([snapshotId, artifactType])
}

/// Dữ liệu bổ sung ngoài run, lấy từ slr-be lúc import (PRISMA writing export, câu trả lời theo RQ).
/// slr-be không đóng băng các dữ liệu này theo run, nên snapshot giữ bản sao tại thời điểm import (ADR-005).
model SnapshotSupplement {
  id            String         @id @default(uuid())
  snapshotId    String
  snapshot      ReviewSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  /// 'prisma_writing_export' hoặc 'rq_findings'
  kind          String
  schemaVersion String?
  contentHash   String
  payload       Json

  @@unique([snapshotId, kind])
}

/// Bản thảo viết từ đúng một snapshot. Mỗi snapshot có tối đa một bản thảo.
model Manuscript {
  id         String              @id @default(uuid())
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  snapshotId String
  snapshot   ReviewSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  createdBy  String
  createdAt  DateTime            @default(now())
  sections   ManuscriptSection[]
  blueprints BlueprintRevision[]
  approvals      Approval[]
  paragraphPlans ParagraphPlanRevision[]
  verificationReports VerificationReport[]
  exportPackages      ExportPackage[]

  @@unique([snapshotId])
}

/// Một mục của bản thảo ('methods', sau này 'results', 'discussion'...).
model ManuscriptSection {
  id           String            @id @default(uuid())
  manuscriptId String
  manuscript   Manuscript        @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  sectionKey   String
  createdAt    DateTime          @default(now())
  revisions    SectionRevision[]

  @@unique([manuscriptId, sectionKey])
}

/// Một phiên bản của mục. Chỉ ghi thêm: trigger trong migration chặn UPDATE và DELETE. Sửa nội dung = phiên bản mới.
model SectionRevision {
  id          String            @id @default(uuid())
  sectionId   String
  section     ManuscriptSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  version     Int
  markdown    String
  /// Các dữ kiện (kèm khoá nguồn) mà văn bản được viết từ đó
  facts       Json
  /// Cảnh báo kèm theo (snapshot hoặc dữ kiện thiếu)
  warnings    Json
  /// Bộ sinh văn bản, ví dụ 'methods-template@1'
  generator   String
  contentHash String
  createdBy   String
  createdAt   DateTime          @default(now())

  @@unique([sectionId, version])
}

/// Một phiên bản của dàn ý (blueprint) bản thảo. Chỉ ghi thêm: sửa dàn ý = phiên bản mới.
model BlueprintRevision {
  id             String     @id @default(uuid())
  manuscriptId   String
  manuscript     Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  version        Int
  /// Profile khung bài báo đã dùng, để biết dàn ý này theo bản profile nào
  profileId      String
  profileVersion Int
  content        Json
  contentHash    String
  /// 'generated' (sinh từ snapshot và profile) hoặc 'edited' (người dùng sửa)
  origin         String
  createdBy      String
  createdAt      DateTime   @default(now())

  paragraphPlans ParagraphPlanRevision[]

  @@unique([manuscriptId, version])
}

/// Quyết định duyệt của người dùng tại một điểm duyệt (H1 dàn ý, H2 nội dung, H3 bản cuối). Chỉ ghi thêm.
/// Trạng thái hiện tại của một đối tượng là quyết định mới nhất về nó.
model Approval {
  id           String     @id @default(uuid())
  /// Thứ tự ghi, tăng dần: quyết định mới nhất về một đối tượng là dòng có seq lớn nhất
  seq          Int        @unique @default(autoincrement())
  manuscriptId String
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  /// 'H1', 'H2' hoặc 'H3'
  stage        String
  /// Loại đối tượng được duyệt, ví dụ 'blueprint_revision'
  targetKind   String
  targetId     String
  /// Hash nội dung đối tượng lúc duyệt
  targetHash   String
  /// 'APPROVED' hoặc 'REJECTED'
  decision     String
  note         String?
  decidedBy    String
  /// Vai trò của người duyệt trong project SLR trên slr-be lúc duyệt ('NOT_CHECKED' nếu cấu hình tắt kiểm tra)
  slrRole      String
  decidedAt    DateTime   @default(now())

  exportPackages ExportPackage[]

  @@index([manuscriptId, stage, targetKind, targetId])
}

/// Nhật ký chỉ ghi thêm. Trigger trong migration chặn UPDATE và DELETE.
model ProvenanceEvent {
  id         String          @id @default(uuid())
  createdAt  DateTime        @default(now())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  snapshotId String?
  snapshot   ReviewSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  actor      String
  activity   String
  inputRefs  Json?
  outputRefs Json?
  method     String?
  notes      String?

  @@index([projectId, createdAt])
}

/// Một phiên bản của kế hoạch từng đoạn (ParagraphPlan). Chỉ ghi thêm: sửa kế hoạch = phiên bản mới.
model ParagraphPlanRevision {
  id                  String            @id @default(uuid())
  manuscriptId        String
  manuscript          Manuscript        @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  version             Int
  blueprintRevisionId String
  blueprintRevision   BlueprintRevision @relation(fields: [blueprintRevisionId], references: [id], onDelete: Restrict)
  content             Json
  contentHash         String
  /// 'generated' hoặc 'edited'
  origin              String
  totalParagraphs     Int
  readyParagraphs     Int
  createdBy           String
  createdAt           DateTime          @default(now())

  @@unique([manuscriptId, version])
  @@index([manuscriptId, blueprintRevisionId])
}

/// Báo cáo kiểm định chất lượng bản thảo (Quality Gates G1-G7). Chỉ ghi thêm.
model VerificationReport {
  id           String     @id @default(uuid())
  manuscriptId String
  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  version      Int
  /// 'PASSED' | 'PASSED_WITH_WARNINGS' | 'FAILED'
  status       String
  /// CitationManifest JSON
  manifest     Json
  /// Record<GateId, QualityGateResult>
  gates        Json
  /// Danh sách ReviewIssue[]
  issues       Json
  /// Thống kê: passed, warnings, failed, needsReview
  summary      Json
  runBy        String
  runAt        DateTime   @default(now())
  exportPackages ExportPackage[]

  @@unique([manuscriptId, version])
  @@index([manuscriptId, status])
}

/// Gói xuất bản cuối cùng của bản thảo (Submission Package). Chỉ ghi thêm: trigger chặn UPDATE/DELETE.
model ExportPackage {
  id                   String             @id @default(uuid())
  manuscriptId         String
  manuscript           Manuscript         @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  version              Int
  h3ApprovalId         String
  h3Approval           Approval           @relation(fields: [h3ApprovalId], references: [id], onDelete: Restrict)
  verificationReportId String
  verificationReport   VerificationReport @relation(fields: [verificationReportId], references: [id], onDelete: Restrict)
  packageHash          String
  /// Chỉ mục các file trong gói (tên file, kích thước bytes, sha256 hash)
  manifest             Json
  /// Nội dung chi tiết có cấu trúc của toàn bộ gói nộp bài
  bundle               Json
  exportedBy           String
  exportedAt           DateTime           @default(now())

  @@unique([manuscriptId, version])
  @@index([manuscriptId, packageHash])
}
